   ],
   "source": [
    "# Chargement du modèle avec Unsloth (4-bit quantization + LoRA)\n",
    "model, tokenizer = FastVisionModel.from_pretrained(\n",
    "    MODEL_NAME,\n",
    "    load_in_4bit=True,\n",
    "    use_gradient_checkpointing=\"unsloth\",  # Économise 30% de VRAM\n",
    ")\n",
    "\n",
    "# Configuration LoRA avec Unsloth\n",
    "model = FastVisionModel.get_peft_model(\n",
    "    model,\n",
    "    r=LORA_CONFIG[\"r\"],\n",
    "    lora_alpha=LORA_CONFIG[\"lora_alpha\"],\n",
    "    lora_dropout=LORA_CONFIG[\"lora_dropout\"],\n",
    "    target_modules=LORA_CONFIG[\"target_modules\"],\n",
    "    use_rslora=True,  # Rank-stabilized LoRA\n",
    "    use_gradient_checkpointing=\"unsloth\"\n",
    ")\n",
    "\n",
    "processor = AutoProcessor.from_pretrained(MODEL_NAME)\n",
    "\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"MODEL LOADED SUCCESSFULLY WITH UNSLOTH\")\n",
    "print(\"=\"*60)\n",
    "print(f\"Model: {MODEL_NAME}\")\n",
    "print(f\"Quantization: 4-bit\")\n",
    "print(f\"LoRA rank: {LORA_CONFIG['r']}\")\n",
    "print(f\"LoRA alpha: {LORA_CONFIG['lora_alpha']}\")\n",
    "print(f\"Trainable parameters: {sum(p.numel() for p in model.parameters() if p.requires_grad):,}\")\n",
    "print(f\"Total parameters: {sum(p.numel() for p in model.parameters()):,}\")\n",
    "print(f\"Trainable %: {100 * sum(p.numel() for p in model.parameters() if p.requires_grad) / sum(p.numel() for p in model.parameters()):.2f}%\")\n",
    "print(\"=\"*60)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Chargement des Datasets"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "PlantVillage VQA: 20,638 samples\n",
      "Disease Diagnosis: 3,963 samples\n",
      "Disease Knowledge: 20 samples\n",
      "\n",
      "Total Stage 1: 24,621 samples\n",
      "\n",
      "============================================================\n",
      "SAMPLE EXAMPLE\n",
      "============================================================\n",
      "ID: plantvillage_Potato___healthy_6f4b9acd-f34d-4771-a6bc-2001de2dd1d3___RS_HL 1898\n",
      "\n",
      "Conversation (2 turns):\n",
      "\n",
      "USER:\n",
      "Picture 1: <img>PlantVillage/Potato___healthy/6f4b9acd-f34d-4771-a6bc-2001de2dd1d3___RS_HL 1898.JPG</img>\n",
      "Can you identify the disease in this image?\n",
      "\n",
      "ASSISTANT:\n",
      "This potato plant appears healthy with no visible disease symptoms.\n",
      "============================================================\n"
     ]
    }
   ],
   "source": [
    "def load_json_dataset(file_path):\n",
    "    \"\"\"Charge un dataset JSON\"\"\"\n",
    "    with open(file_path, 'r', encoding='utf-8') as f:\n",
    "        return json.load(f)\n",
    "\n",
    "# Chargement des 3 datasets Stage 1\n",
    "plantvillage_data = load_json_dataset(DATA_DIR / \"plantvillage_vqa.json\")\n",
    "disease_diagnosis_data = load_json_dataset(DATA_DIR / \"disease_diagnosis.json\")\n",
    "disease_knowledge_data = load_json_dataset(DATA_DIR / \"disease_knowledge.json\")\n",
    "\n",
    "print(f\"PlantVillage VQA: {len(plantvillage_data):,} samples\")\n",
    "print(f\"Disease Diagnosis: {len(disease_diagnosis_data):,} samples\")\n",
    "print(f\"Disease Knowledge: {len(disease_knowledge_data):,} samples\")\n",
    "\n",
    "# Combinaison des datasets\n",
    "all_data = plantvillage_data + disease_diagnosis_data + disease_knowledge_data\n",
    "print(f\"\\nTotal Stage 1: {len(all_data):,} samples\")\n",
    "\n",
    "# Exemple d'échantillon\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"SAMPLE EXAMPLE\")\n",
    "print(\"=\"*60)\n",
    "sample = all_data[0]\n",
    "print(f\"ID: {sample['id']}\")\n",
    "print(f\"\\nConversation ({len(sample['conversations'])} turns):\")\n",
    "for turn in sample['conversations']:\n",
    "    print(f\"\\n{turn['from'].upper()}:\")\n",
    "    print(turn['value'][:200] + \"...\" if len(turn['value']) > 200 else turn['value'])\n",
    "print(\"=\"*60)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Préparation des Données pour l'Entraînement"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "Formatting dataset: 100%|██████████| 24621/24621 [00:00<00:00, 342382.23it/s]"
