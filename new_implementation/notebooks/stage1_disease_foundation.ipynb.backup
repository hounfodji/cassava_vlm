     "text": [
      "Unsloth: Making `model.base_model.model.model` require gradients\n",
      "\n",
      "============================================================\n",
      "MODEL LOADED SUCCESSFULLY WITH UNSLOTH\n",
      "============================================================\n",
      "Model: unsloth/Qwen3-VL-8B-Instruct-unsloth-bnb-4bit\n",
