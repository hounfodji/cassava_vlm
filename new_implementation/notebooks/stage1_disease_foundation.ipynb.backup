   "source": [
    "import os\n",
    "import json\n",
    "import torch\n",
    "from pathlib import Path\n",
    "from datasets import Dataset\n",
    "from transformers import (\n",
    "    AutoProcessor,\n",
    "    TrainingArguments,\n",
    "    Trainer\n",
    ")\n",
    "from unsloth import FastVisionModel\n",
    "from trl import SFTTrainer\n",
    "import numpy as np\n",
    "from tqdm import tqdm\n",
    "\n",
    "print(f\"PyTorch version: {torch.__version__}\")\n",
    "print(f\"CUDA available: {torch.cuda.is_available()}\")\n",
    "if torch.cuda.is_available():\n",
    "    print(f\"GPU: {torch.cuda.get_device_name(0)}\")\n",
    "    print(f\"GPU Memory: {torch.cuda.get_device_properties(0).total_memory / 1e9:.2f} GB\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Configuration"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Base Directory: /home/hounfodjidagba/learning/agrovista\n",
      "Data Directory: /home/hounfodjidagba/learning/agrovista/data/stage1\n",
      "Checkpoint Directory: /home/hounfodjidagba/learning/agrovista/checkpoints/stage1_disease_foundation\n",
      "\n",
      "Training Configuration:\n",
      "  per_device_train_batch_size: 2\n",
      "  gradient_accumulation_steps: 4\n",
      "  num_train_epochs: 3\n",
      "  learning_rate: 2e-05\n",
      "  warmup_steps: 100\n",
      "  logging_steps: 25\n",
      "  save_steps: 500\n",
      "  save_total_limit: 3\n",
      "  fp16: True\n",
      "  bf16: False\n",
      "  optim: adamw_8bit\n",
      "  weight_decay: 0.01\n",
      "  lr_scheduler_type: cosine\n",
      "  max_grad_norm: 1.0\n",
      "  seed: 42\n"
     ]
    }
   ],
   "source": [
    "# Chemins\n",
    "BASE_DIR = Path(\"/home/hounfodjidagba/learning/agrovista\")\n",
    "DATA_DIR = BASE_DIR / \"data\" / \"stage1\"\n",
    "CHECKPOINT_DIR = BASE_DIR / \"checkpoints\" / \"stage1_disease_foundation\"\n",
    "CHECKPOINT_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# Modèle - Utiliser la version pré-optimisée Unsloth pour Qwen3-VL-8B\n",
    "MODEL_NAME = \"unsloth/Qwen3-VL-8B-Instruct-unsloth-bnb-4bit\"  # Unsloth optimisé 4-bit\n",
    "# Alternative: \"Qwen/Qwen3-VL-8B-Instruct\" pour la version officielle\n",
    "\n",
    "# LoRA Configuration\n",
    "LORA_CONFIG = {\n",
    "    \"r\": 32,\n",
    "    \"lora_alpha\": 64,\n",
    "    \"lora_dropout\": 0.05,\n",
    "    \"target_modules\": [\"q_proj\", \"k_proj\", \"v_proj\", \"o_proj\", \"gate_proj\", \"up_proj\", \"down_proj\"],\n",
    "    \"bias\": \"none\",\n",
    "    \"task_type\": \"CAUSAL_LM\"\n",
    "}\n",
    "\n",
    "# Training Configuration\n",
    "TRAINING_CONFIG = {\n",
    "    \"per_device_train_batch_size\": 2,\n",
    "    \"gradient_accumulation_steps\": 4,  # Effective batch size = 8\n",
    "    \"num_train_epochs\": 3,\n",
    "    \"learning_rate\": 2e-5,\n",
    "    \"warmup_steps\": 100,\n",
    "    \"logging_steps\": 25,\n",
    "    \"save_steps\": 500,\n",
    "    \"save_total_limit\": 3,\n",
    "    \"fp16\": not torch.cuda.is_bf16_supported(),\n",
    "    \"bf16\": torch.cuda.is_bf16_supported(),\n",
    "    \"optim\": \"adamw_8bit\",\n",
    "    \"weight_decay\": 0.01,\n",
    "    \"lr_scheduler_type\": \"cosine\",\n",
    "    \"max_grad_norm\": 1.0,\n",
    "    \"seed\": 42\n",
    "}\n",
    "\n",
    "print(f\"Base Directory: {BASE_DIR}\")\n",
    "print(f\"Data Directory: {DATA_DIR}\")\n",
    "print(f\"Checkpoint Directory: {CHECKPOINT_DIR}\")\n",
    "print(f\"\\nTraining Configuration:\")\n",
    "for key, value in TRAINING_CONFIG.items():\n",
    "    print(f\"  {key}: {value}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Chargement du Modèle avec Unsloth"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [
