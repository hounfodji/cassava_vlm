      "\u001b[36mFile \u001b[39m\u001b[32m~/miniconda3/envs/new_fine/lib/python3.11/site-packages/transformers/image_processing_utils_fast.py:757\u001b[39m, in \u001b[36mBaseImageProcessorFast.preprocess\u001b[39m\u001b[34m(self, images, *args, **kwargs)\u001b[39m\n\u001b[32m    754\u001b[39m \u001b[38;5;66;03m# Pop kwargs that are not needed in _preprocess\u001b[39;00m\n\u001b[32m    755\u001b[39m kwargs.pop(\u001b[33m\"\u001b[39m\u001b[33mdata_format\u001b[39m\u001b[33m\"\u001b[39m)\n\u001b[32m--> \u001b[39m\u001b[32m757\u001b[39m \u001b[38;5;28;01mreturn\u001b[39;00m \u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43m_preprocess_image_like_inputs\u001b[49m\u001b[43m(\u001b[49m\n\u001b[32m    758\u001b[39m \u001b[43m    \u001b[49m\u001b[43mimages\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43m*\u001b[49m\u001b[43margs\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mdo_convert_rgb\u001b[49m\u001b[43m=\u001b[49m\u001b[43mdo_convert_rgb\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43minput_data_format\u001b[49m\u001b[43m=\u001b[49m\u001b[43minput_data_format\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mdevice\u001b[49m\u001b[43m=\u001b[49m\u001b[43mdevice\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43m*\u001b[49m\u001b[43m*\u001b[49m\u001b[43mkwargs\u001b[49m\n\u001b[32m    759\u001b[39m \u001b[43m\u001b[49m\u001b[43m)\u001b[49m\n",
      "\u001b[36mFile \u001b[39m\u001b[32m~/miniconda3/envs/new_fine/lib/python3.11/site-packages/transformers/models/qwen2_vl/image_processing_qwen2_vl_fast.py:160\u001b[39m, in \u001b[36mQwen2VLImageProcessorFast._preprocess_image_like_inputs\u001b[39m\u001b[34m(self, images, videos, do_convert_rgb, input_data_format, device, **kwargs)\u001b[39m\n\u001b[32m    158\u001b[39m batch_feature = BatchFeature()\n\u001b[32m    159\u001b[39m \u001b[38;5;28;01mif\u001b[39;00m images \u001b[38;5;129;01mis\u001b[39;00m \u001b[38;5;129;01mnot\u001b[39;00m \u001b[38;5;28;01mNone\u001b[39;00m:\n\u001b[32m--> \u001b[39m\u001b[32m160\u001b[39m     images = \u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43m_prepare_image_like_inputs\u001b[49m\u001b[43m(\u001b[49m\n\u001b[32m    161\u001b[39m \u001b[43m        \u001b[49m\u001b[43mimages\u001b[49m\u001b[43m=\u001b[49m\u001b[43mimages\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mdo_convert_rgb\u001b[49m\u001b[43m=\u001b[49m\u001b[43mdo_convert_rgb\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43minput_data_format\u001b[49m\u001b[43m=\u001b[49m\u001b[43minput_data_format\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mdevice\u001b[49m\u001b[43m=\u001b[49m\u001b[43mdevice\u001b[49m\n\u001b[32m    162\u001b[39m \u001b[43m    \u001b[49m\u001b[43m)\u001b[49m\n\u001b[32m    163\u001b[39m     batch_feature = \u001b[38;5;28mself\u001b[39m._preprocess(images, **kwargs)\n\u001b[32m    164\u001b[39m \u001b[38;5;28;01mif\u001b[39;00m videos \u001b[38;5;129;01mis\u001b[39;00m \u001b[38;5;129;01mnot\u001b[39;00m \u001b[38;5;28;01mNone\u001b[39;00m:\n",
      "\u001b[36mFile \u001b[39m\u001b[32m~/miniconda3/envs/new_fine/lib/python3.11/site-packages/transformers/image_processing_utils_fast.py:633\u001b[39m, in \u001b[36mBaseImageProcessorFast._prepare_image_like_inputs\u001b[39m\u001b[34m(self, images, do_convert_rgb, input_data_format, device, expected_ndims)\u001b[39m\n\u001b[32m    613\u001b[39m \u001b[38;5;250m\u001b[39m\u001b[33;03m\"\"\"\u001b[39;00m\n\u001b[32m    614\u001b[39m \u001b[33;03mPrepare image-like inputs for processing.\u001b[39;00m\n\u001b[32m    615\u001b[39m \n\u001b[32m   (...)\u001b[39m\u001b[32m    629\u001b[39m \u001b[33;03m    List[`torch.Tensor`]: The processed images.\u001b[39;00m\n\u001b[32m    630\u001b[39m \u001b[33;03m\"\"\"\u001b[39;00m\n\u001b[32m    632\u001b[39m \u001b[38;5;66;03m# Get structured images (potentially nested)\u001b[39;00m\n\u001b[32m--> \u001b[39m\u001b[32m633\u001b[39m images = \u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43m_prepare_images_structure\u001b[49m\u001b[43m(\u001b[49m\u001b[43mimages\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mexpected_ndims\u001b[49m\u001b[43m=\u001b[49m\u001b[43mexpected_ndims\u001b[49m\u001b[43m)\u001b[49m\n\u001b[32m    635\u001b[39m process_image_partial = partial(\n\u001b[32m    636\u001b[39m     \u001b[38;5;28mself\u001b[39m._process_image, do_convert_rgb=do_convert_rgb, input_data_format=input_data_format, device=device\n\u001b[32m    637\u001b[39m )\n\u001b[32m    639\u001b[39m \u001b[38;5;66;03m# Check if we have nested structure, assuming the nesting is consistent\u001b[39;00m\n",
      "\u001b[36mFile \u001b[39m\u001b[32m~/miniconda3/envs/new_fine/lib/python3.11/site-packages/transformers/image_processing_utils_fast.py:564\u001b[39m, in \u001b[36mBaseImageProcessorFast._prepare_images_structure\u001b[39m\u001b[34m(self, images, expected_ndims)\u001b[39m\n\u001b[32m    553\u001b[39m \u001b[38;5;250m\u001b[39m\u001b[33;03m\"\"\"\u001b[39;00m\n\u001b[32m    554\u001b[39m \u001b[33;03mPrepare the images structure for processing.\u001b[39;00m\n\u001b[32m    555\u001b[39m \n\u001b[32m   (...)\u001b[39m\u001b[32m    561\u001b[39m \u001b[33;03m    `ImageInput`: The images with a valid nesting.\u001b[39;00m\n\u001b[32m    562\u001b[39m \u001b[33;03m\"\"\"\u001b[39;00m\n\u001b[32m    563\u001b[39m \u001b[38;5;66;03m# Checks for `str` in case of URL/local path and optionally loads images\u001b[39;00m\n\u001b[32m--> \u001b[39m\u001b[32m564\u001b[39m images = \u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43mfetch_images\u001b[49m\u001b[43m(\u001b[49m\u001b[43mimages\u001b[49m\u001b[43m)\u001b[49m\n\u001b[32m    565\u001b[39m \u001b[38;5;28;01mreturn\u001b[39;00m make_flat_list_of_images(images, expected_ndims=expected_ndims)\n",
      "\u001b[36mFile \u001b[39m\u001b[32m~/miniconda3/envs/new_fine/lib/python3.11/site-packages/transformers/image_processing_base.py:530\u001b[39m, in \u001b[36mImageProcessingMixin.fetch_images\u001b[39m\u001b[34m(self, image_url_or_urls)\u001b[39m\n\u001b[32m    523\u001b[39m \u001b[38;5;250m\u001b[39m\u001b[33;03m\"\"\"\u001b[39;00m\n\u001b[32m    524\u001b[39m \u001b[33;03mConvert a single or a list of urls into the corresponding `PIL.Image` objects.\u001b[39;00m\n\u001b[32m    525\u001b[39m \n\u001b[32m    526\u001b[39m \u001b[33;03mIf a single url is passed, the return value will be a single object. If a list is passed a list of objects is\u001b[39;00m\n\u001b[32m    527\u001b[39m \u001b[33;03mreturned.\u001b[39;00m\n\u001b[32m    528\u001b[39m \u001b[33;03m\"\"\"\u001b[39;00m\n\u001b[32m    529\u001b[39m \u001b[38;5;28;01mif\u001b[39;00m \u001b[38;5;28misinstance\u001b[39m(image_url_or_urls, \u001b[38;5;28mlist\u001b[39m):\n\u001b[32m--> \u001b[39m\u001b[32m530\u001b[39m     \u001b[38;5;28;01mreturn\u001b[39;00m \u001b[43m[\u001b[49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43mfetch_images\u001b[49m\u001b[43m(\u001b[49m\u001b[43mx\u001b[49m\u001b[43m)\u001b[49m\u001b[43m \u001b[49m\u001b[38;5;28;43;01mfor\u001b[39;49;00m\u001b[43m \u001b[49m\u001b[43mx\u001b[49m\u001b[43m \u001b[49m\u001b[38;5;129;43;01min\u001b[39;49;00m\u001b[43m \u001b[49m\u001b[43mimage_url_or_urls\u001b[49m\u001b[43m]\u001b[49m\n\u001b[32m    531\u001b[39m \u001b[38;5;28;01melif\u001b[39;00m \u001b[38;5;28misinstance\u001b[39m(image_url_or_urls, \u001b[38;5;28mstr\u001b[39m):\n\u001b[32m    532\u001b[39m     \u001b[38;5;28;01mreturn\u001b[39;00m load_image(image_url_or_urls)\n",
      "\u001b[36mFile \u001b[39m\u001b[32m~/miniconda3/envs/new_fine/lib/python3.11/site-packages/transformers/image_processing_base.py:530\u001b[39m, in \u001b[36m<listcomp>\u001b[39m\u001b[34m(.0)\u001b[39m\n\u001b[32m    523\u001b[39m \u001b[38;5;250m\u001b[39m\u001b[33;03m\"\"\"\u001b[39;00m\n\u001b[32m    524\u001b[39m \u001b[33;03mConvert a single or a list of urls into the corresponding `PIL.Image` objects.\u001b[39;00m\n\u001b[32m    525\u001b[39m \n\u001b[32m    526\u001b[39m \u001b[33;03mIf a single url is passed, the return value will be a single object. If a list is passed a list of objects is\u001b[39;00m\n\u001b[32m    527\u001b[39m \u001b[33;03mreturned.\u001b[39;00m\n\u001b[32m    528\u001b[39m \u001b[33;03m\"\"\"\u001b[39;00m\n\u001b[32m    529\u001b[39m \u001b[38;5;28;01mif\u001b[39;00m \u001b[38;5;28misinstance\u001b[39m(image_url_or_urls, \u001b[38;5;28mlist\u001b[39m):\n\u001b[32m--> \u001b[39m\u001b[32m530\u001b[39m     \u001b[38;5;28;01mreturn\u001b[39;00m [\u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43mfetch_images\u001b[49m\u001b[43m(\u001b[49m\u001b[43mx\u001b[49m\u001b[43m)\u001b[49m \u001b[38;5;28;01mfor\u001b[39;00m x \u001b[38;5;129;01min\u001b[39;00m image_url_or_urls]\n\u001b[32m    531\u001b[39m \u001b[38;5;28;01melif\u001b[39;00m \u001b[38;5;28misinstance\u001b[39m(image_url_or_urls, \u001b[38;5;28mstr\u001b[39m):\n\u001b[32m    532\u001b[39m     \u001b[38;5;28;01mreturn\u001b[39;00m load_image(image_url_or_urls)\n",
      "\u001b[36mFile \u001b[39m\u001b[32m~/miniconda3/envs/new_fine/lib/python3.11/site-packages/transformers/image_processing_base.py:532\u001b[39m, in \u001b[36mImageProcessingMixin.fetch_images\u001b[39m\u001b[34m(self, image_url_or_urls)\u001b[39m\n\u001b[32m    530\u001b[39m     \u001b[38;5;28;01mreturn\u001b[39;00m [\u001b[38;5;28mself\u001b[39m.fetch_images(x) \u001b[38;5;28;01mfor\u001b[39;00m x \u001b[38;5;129;01min\u001b[39;00m image_url_or_urls]\n\u001b[32m    531\u001b[39m \u001b[38;5;28;01melif\u001b[39;00m \u001b[38;5;28misinstance\u001b[39m(image_url_or_urls, \u001b[38;5;28mstr\u001b[39m):\n\u001b[32m--> \u001b[39m\u001b[32m532\u001b[39m     \u001b[38;5;28;01mreturn\u001b[39;00m \u001b[43mload_image\u001b[49m\u001b[43m(\u001b[49m\u001b[43mimage_url_or_urls\u001b[49m\u001b[43m)\u001b[49m\n\u001b[32m    533\u001b[39m \u001b[38;5;28;01melif\u001b[39;00m is_valid_image(image_url_or_urls):\n\u001b[32m    534\u001b[39m     \u001b[38;5;28;01mreturn\u001b[39;00m image_url_or_urls\n",
      "\u001b[36mFile \u001b[39m\u001b[32m~/miniconda3/envs/new_fine/lib/python3.11/site-packages/transformers/image_utils.py:483\u001b[39m, in \u001b[36mload_image\u001b[39m\u001b[34m(image, timeout)\u001b[39m\n\u001b[32m    481\u001b[39m             image = PIL.Image.open(BytesIO(b64))\n\u001b[32m    482\u001b[39m         \u001b[38;5;28;01mexcept\u001b[39;00m \u001b[38;5;167;01mException\u001b[39;00m \u001b[38;5;28;01mas\u001b[39;00m e:\n\u001b[32m--> \u001b[39m\u001b[32m483\u001b[39m             \u001b[38;5;28;01mraise\u001b[39;00m \u001b[38;5;167;01mValueError\u001b[39;00m(\n\u001b[32m    484\u001b[39m                 \u001b[33mf\u001b[39m\u001b[33m\"\u001b[39m\u001b[33mIncorrect image source. Must be a valid URL starting with `http://` or `https://`, a valid path to an image file, or a base64 encoded string. Got \u001b[39m\u001b[38;5;132;01m{\u001b[39;00mimage\u001b[38;5;132;01m}\u001b[39;00m\u001b[33m. Failed with \u001b[39m\u001b[38;5;132;01m{\u001b[39;00me\u001b[38;5;132;01m}\u001b[39;00m\u001b[33m\"\u001b[39m\n\u001b[32m    485\u001b[39m             )\n\u001b[32m    486\u001b[39m \u001b[38;5;28;01melif\u001b[39;00m \u001b[38;5;129;01mnot\u001b[39;00m \u001b[38;5;28misinstance\u001b[39m(image, PIL.Image.Image):\n\u001b[32m    487\u001b[39m     \u001b[38;5;28;01mraise\u001b[39;00m \u001b[38;5;167;01mTypeError\u001b[39;00m(\n\u001b[32m    488\u001b[39m         \u001b[33m\"\u001b[39m\u001b[33mIncorrect format used for image. Should be an url linking to an image, a base64 string, a local path, or a PIL image.\u001b[39m\u001b[33m\"\u001b[39m\n\u001b[32m    489\u001b[39m     )\n",
      "\u001b[31mValueError\u001b[39m: Incorrect image source. Must be a valid URL starting with `http://` or `https://`, a valid path to an image file, or a base64 encoded string. Got <|im_start|>user\n<img>data/raw/cddm/images/Peach,Healthy/plant_127512.jpg</img>\nIs this leaf from an apple tree? <|im_end|>\n<|im_start|>assistant\nNo, this is a peach leaf.<|im_end|>\n. Failed with Incorrect padding"
     ]
    }
   ],
   "source": [
    "training_args = TrainingArguments(\n",
    "    output_dir=str(CHECKPOINT_DIR),\n",
    "    per_device_train_batch_size=TRAINING_CONFIG[\"per_device_train_batch_size\"],\n",
    "    per_device_eval_batch_size=TRAINING_CONFIG[\"per_device_train_batch_size\"],\n",
    "    gradient_accumulation_steps=TRAINING_CONFIG[\"gradient_accumulation_steps\"],\n",
    "    num_train_epochs=TRAINING_CONFIG[\"num_train_epochs\"],\n",
    "    learning_rate=TRAINING_CONFIG[\"learning_rate\"],\n",
    "    warmup_steps=TRAINING_CONFIG[\"warmup_steps\"],\n",
    "    logging_steps=TRAINING_CONFIG[\"logging_steps\"],\n",
    "    save_steps=TRAINING_CONFIG[\"save_steps\"],\n",
    "    save_total_limit=TRAINING_CONFIG[\"save_total_limit\"],\n",
    "    eval_strategy=\"steps\",  # Changé de evaluation_strategy à eval_strategy\n",
    "    eval_steps=TRAINING_CONFIG[\"save_steps\"],\n",
    "    fp16=TRAINING_CONFIG[\"fp16\"],\n",
    "    bf16=TRAINING_CONFIG[\"bf16\"],\n",
    "    optim=TRAINING_CONFIG[\"optim\"],\n",
    "    weight_decay=TRAINING_CONFIG[\"weight_decay\"],\n",
    "    lr_scheduler_type=TRAINING_CONFIG[\"lr_scheduler_type\"],\n",
    "    max_grad_norm=TRAINING_CONFIG[\"max_grad_norm\"],\n",
    "    seed=TRAINING_CONFIG[\"seed\"],\n",
    "    report_to=\"none\",  # Disable wandb/tensorboard\n",
    "    remove_unused_columns=False,\n",
    "    load_best_model_at_end=True,\n",
    "    metric_for_best_model=\"eval_loss\",\n",
    "    greater_is_better=False,\n",
    ")\n",
    "\n",
    "# Création du SFTTrainer avec Unsloth\n",
    "trainer = SFTTrainer(\n",
    "    model=model,\n",
    "    tokenizer=tokenizer,\n",
    "    train_dataset=train_dataset,\n",
    "    eval_dataset=eval_dataset,\n",
    "    args=training_args,\n",
    "    dataset_text_field=\"text\",\n",
    "    max_seq_length=2048,\n",
    "    packing=False,  # Important pour vision models\n",
    ")\n",
    "\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"TRAINER CONFIGURED\")\n",
    "print(\"=\"*60)\n",
    "print(f\"Effective batch size: {TRAINING_CONFIG['per_device_train_batch_size'] * TRAINING_CONFIG['gradient_accumulation_steps']}\")\n",
    "print(f\"Total training steps: {len(train_dataset) // (TRAINING_CONFIG['per_device_train_batch_size'] * TRAINING_CONFIG['gradient_accumulation_steps']) * TRAINING_CONFIG['num_train_epochs']}\")\n",
    "print(f\"Warmup steps: {TRAINING_CONFIG['warmup_steps']}\")\n",
    "print(f\"Eval every: {TRAINING_CONFIG['save_steps']} steps\")\n",
    "print(\"=\"*60)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Entraînement"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"STARTING TRAINING - STAGE 1: DISEASE FOUNDATION\")\n",
    "print(\"=\"*60)\n",
    "print(f\"Estimated time: 6-8 hours on V100 16GB\")\n",
    "print(f\"Target metrics:\")\n",
    "print(f\"  - Disease classification accuracy: >90%\")\n",
    "print(f\"  - Crop identification accuracy: >95%\")\n",
    "print(\"=\"*60)\n",
    "print(\"\\n\")\n",
    "\n",
    "# Entraînement\n",
    "trainer.train()\n",
    "\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"TRAINING COMPLETED\")\n",
    "print(\"=\"*60)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Sauvegarde du Modèle"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Sauvegarde du modèle final\n",
    "final_model_path = CHECKPOINT_DIR / \"final_model\"\n",
    "trainer.save_model(str(final_model_path))\n",
    "tokenizer.save_pretrained(str(final_model_path))\n",
    "\n",
    "print(f\"\\nModèle sauvegardé dans: {final_model_path}\")\n",
    "\n",
    "# Sauvegarde des adapters LoRA seulement (pour merge plus tard)\n",
    "lora_adapters_path = CHECKPOINT_DIR / \"lora_adapters\"\n",
    "model.save_pretrained(str(lora_adapters_path))\n",
    "\n",
    "print(f\"Adapters LoRA sauvegardés dans: {lora_adapters_path}\")\n",
    "\n",
    "# Sauvegarde des métriques\n",
    "metrics_path = CHECKPOINT_DIR / \"training_metrics.json\"\n",
    "metrics = {\n",
    "    \"stage\": \"stage1_disease_foundation\",\n",
    "    \"model\": MODEL_NAME,\n",
    "    \"train_samples\": len(train_dataset),\n",
    "    \"eval_samples\": len(eval_dataset),\n",
    "    \"epochs\": TRAINING_CONFIG[\"num_train_epochs\"],\n",
    "    \"final_train_loss\": trainer.state.log_history[-2]['loss'] if len(trainer.state.log_history) > 1 else None,\n",
    "    \"final_eval_loss\": trainer.state.log_history[-1]['eval_loss'] if len(trainer.state.log_history) > 0 else None,\n",
    "    \"lora_config\": LORA_CONFIG,\n",
    "    \"training_config\": TRAINING_CONFIG\n",
    "}\n",
    "\n",
    "with open(metrics_path, 'w') as f:\n",
    "    json.dump(metrics, f, indent=2)\n",
    "\n",
    "print(f\"Métriques sauvegardées dans: {metrics_path}\")\n",
    "\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"STAGE 1 COMPLETED SUCCESSFULLY\")\n",
    "print(\"=\"*60)\n",
    "print(f\"\\nNext steps:\")\n",
    "print(f\"1. Valider le modèle sur disease accuracy (target >90%)\")\n",
    "print(f\"2. Push checkpoint to Hugging Face Hub\")\n",
    "print(f\"3. Préparer Stage 2: Multi-Turn CDDM (145k conversations)\")\n",
    "print(\"=\"*60)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 9. Test Rapide du Modèle"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Test simple pour vérifier que le modèle fonctionne\n",
    "from PIL import Image\n",
    "\n",
    "# Prendre une image de test du dataset\n",
    "test_sample = eval_dataset[0]\n",
    "print(\"Test input:\")\n",
    "print(test_sample['text'][:300])\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "\n",
    "# Génération\n",
    "model.eval()\n",
    "inputs = tokenizer(test_sample['text'], return_tensors=\"pt\").to(model.device)\n",
    "\n",
    "with torch.no_grad():\n",
    "    outputs = model.generate(\n",
    "        **inputs,\n",
    "        max_new_tokens=200,\n",
    "        temperature=0.7,\n",
    "        do_sample=True,\n",
    "        top_p=0.9\n",
    "    )\n",
    "\n",
    "response = tokenizer.decode(outputs[0], skip_special_tokens=False)\n",
    "print(\"Model response:\")\n",
    "print(response)\n",
    "print(\"=\"*60)"
   ]
  }
