    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "Dataset créé: 24621 samples\n",
      "Colonnes: ['text', 'id']\n",
      "\n",
      "Train: 23,389 samples\n",
      "Validation: 1,232 samples\n",
      "\n",
      "============================================================\n",
      "FORMATTED EXAMPLE\n",
      "============================================================\n",
      "<|im_start|>user\n",
      "<img>data/raw/cddm/images/Peach,Healthy/plant_127512.jpg</img>\n",
      "Is this leaf from an apple tree? <|im_end|>\n",
      "<|im_start|>assistant\n",
      "No, this is a peach leaf.<|im_end|>\n",
      "\n",
      "...\n",
      "============================================================\n"
     ]
    },
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "\n"
     ]
    }
   ],
   "source": [
    "def format_conversation_for_training(sample):\n",
    "    \"\"\"\n",
    "    Convertit une conversation au format Qwen3-VL.\n",
    "    \n",
    "    Format attendu:\n",
    "    <|im_start|>user\n",
    "    <img>path</img>\\nQuestion<|im_end|>\n",
    "    <|im_start|>assistant\n",
    "    Answer<|im_end|>\n",
    "    \"\"\"\n",
    "    formatted_text = \"\"\n",
    "    \n",
    "    for turn in sample['conversations']:\n",
    "        role = turn['from']\n",
    "        content = turn['value']\n",
    "        \n",
    "        formatted_text += f\"<|im_start|>{role}\\n{content}<|im_end|>\\n\"\n",
    "    \n",
    "    return formatted_text\n",
    "\n",
    "# Création du dataset Hugging Face\n",
    "formatted_data = []\n",
    "for sample in tqdm(all_data, desc=\"Formatting dataset\"):\n",
    "    formatted_text = format_conversation_for_training(sample)\n",
    "    formatted_data.append({\n",
    "        \"text\": formatted_text,\n",
    "        \"id\": sample['id']\n",
    "    })\n",
    "\n",
    "dataset = Dataset.from_list(formatted_data)\n",
    "print(f\"\\nDataset créé: {len(dataset)} samples\")\n",
    "print(f\"Colonnes: {dataset.column_names}\")\n",
    "\n",
    "# Split train/validation (95/5)\n",
    "dataset = dataset.train_test_split(test_size=0.05, seed=42)\n",
    "train_dataset = dataset['train']\n",
    "eval_dataset = dataset['test']\n",
    "\n",
    "print(f\"\\nTrain: {len(train_dataset):,} samples\")\n",
    "print(f\"Validation: {len(eval_dataset):,} samples\")\n",
    "\n",
    "# Exemple formaté\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"FORMATTED EXAMPLE\")\n",
    "print(\"=\"*60)\n",
    "print(train_dataset[0]['text'][:500])\n",
    "print(\"...\")\n",
    "print(\"=\"*60)"
   ]
  },
  {
