lid rgba(102,126,234,0.4); box-shadow: 0 8px 22px rgba(0,0,0,0.3); margin: 8px 0 16px 0; overflow: hidden; } /* Decorative gradient accents - Dark Mode */ .gallery-callout::before, .gallery-callout::after { content: \"\"; position: absolute; width: 180px; height: 180px; border-radius: 50%; filter: blur(48px); opacity: 0.3; pointer-events: none; } .gallery-callout::before { top: -70px; left: -70px; background: radial-gradient(closest-side, rgba(102,126,234,0.7), transparent 70%); } .gallery-callout::after { bottom: -80px; right: -60px; background: radial-gradient(closest-side, rgba(118,75,162,0.7), transparent 70%); } /* Heading row for visual pop (optional if you add a title) - Dark Mode */ .gallery-head { display: flex; align-items: center; gap: 10px; margin: 0 0 6px 0; } .gallery-badge { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 9px; background: linear-gradient(135deg, #667eea, #764ba2); color: #ffffff; font-weight: 800; font-size: 13px; box-shadow: inset 0 0 0 1px rgba(255,255,255,0.25), 0 6px 14px rgba(102,126,234,0.4); } .gallery-title { margin: 0; font-size: 18px; font-weight: 800; color: #ffffff !important; } /* Content text refinement - Dark Mode */ .gallery-text { margin: 6px 0 0 0; color: #ffffff !important; line-height: 1.5; } </style> <div class=\"gallery-callout\"> <!-- Optional header: uncomment if you want a small header above the text <div class=\"gallery-head\"> <span class=\"gallery-badge\">📷</span> <h3 class=\"gallery-title\">Sample Gallery &amp; Stats</h3> </div> --> <div class=\"gallery-text\"> Visualize a small gallery of the Agri-LLaVA dataset and its basic statistics below. </div> </div>\n"},"metadata":{}}],"execution_count":8},{"cell_type":"code","source":"import matplotlib.pyplot as plt\nfrom IPython.display import display, HTML\n\ndef create_image_gallery(dataset, num_samples=9):\n    n = min(num_samples, len(dataset))\n    cols = 3\n    rows = (n + cols - 1) // cols\n    fig, axes = plt.subplots(rows, cols, figsize=(4*cols, 4*rows))\n    axes = axes.flat if n > 1 else [axes]\n    i = 0\n    for ax in axes:\n        if i < n:\n            msg = dataset[i][\"messages\"]\n            img_obj = None\n            for m in msg:\n                for c in m[\"content\"]:\n                    if isinstance(c, dict) and c.get(\"type\") == \"image\" and isinstance(c.get(\"image\"), Image.Image):\n                        img_obj = c[\"image\"]\n                        break\n                if img_obj: break\n            if img_obj:\n                ax.imshow(img_obj)\n                ax.set_title(f\"Sample {i+1}\")\n            ax.axis(\"off\")\n            i += 1\n        else:\n            ax.axis(\"off\")\n    plt.suptitle(\"Agri-LLaVA Sample Images\", fontsize=16, fontweight=\"bold\")\n    plt.tight_layout()\n    plt.show()\ncreate_image_gallery(train_dataset, num_samples=9)","metadata":{"_cell_guid":"67ed7ab3-3843-4e10-b867-a4da9542820b","_uuid":"4662bdd1-987c-4573-9b83-375d76060f1f","collapsed":false,"jupyter":{"outputs_hidden":false},"trusted":true,"execution":{"iopub.status.busy":"2025-08-06T15:22:34.107596Z","iopub.execute_input":"2025-08-06T15:22:34.107897Z","iopub.status.idle":"2025-08-06T15:22:36.080955Z","shell.execute_reply.started":"2025-08-06T15:22:34.107872Z","shell.execute_reply":"2025-08-06T15:22:36.079222Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x1200 with 9 Axes>","image/png":"