ant; overflow: hidden; z-index: 0; } .callout.pretty::before { content: \"\"; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, transparent 0%, rgba(102,126,234,0.08) 100%); border-radius: 12px; pointer-events: none; } .kpi.tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; margin-top: 16px; } .kpi.tiles > div { position: relative; background: rgba(45,45,55,0.8); border-radius: 14px; padding: 16px 16px 14px 16px; text-align: center; border: 1px solid rgba(102,126,234,0.3); overflow: hidden; transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease; color: #ffffff !important; display: flex; flex-direction: column; justify-content: center; align-items: center; } .kpi.tiles > div::after { content: \"\"; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(120px 60px at 20% -20%, rgba(102,126,234,0.18), transparent 60%), radial-gradient(120px 60px at 120% 120%, rgba(118,75,162,0.18), transparent 60%); } .kpi.tiles > div:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(102,126,234,0.3); border-color: rgba(102,126,234,0.5); background: rgba(50,50,60,0.9); } .kpi.tiles h3 { margin: 0 0 6px 0; font-weight: 800; color: #ffffff !important; text-align: center; } .kpi.tiles p { margin: 0; color: #ffffff !important; text-align: center; width: 100%; } .hr-fancy { height: 3px; border: none; background: linear-gradient(to right, #667eea, #764ba2); border-radius: 3px; margin: 22px 0; } .section-hero > :first-child { margin-top: 0; } .section-hero > :last-child { margin-bottom: 0; } @media (max-width: 520px) { .overview-emoji { width: 34px; height: 34px; font-size: 18px; } .overview-title { font-size: 20px; } } </style> <div class=\"section-hero\"> <div class=\"overview-head\"> <span class=\"overview-emoji\">1</span> <h2 class=\"overview-title\" id=\"overview\">Project Overview</h2> </div> <div class=\"callout pretty\"> The <b>AgriVision-Gemma3n</b> project aims to create a powerful, offline-capable multimodal AI assistant for farmers. The model is designed to diagnose crop diseases from images and provide actionable advice, accessible on mobile devices without an internet connection. <br><br> This notebook demonstrates the capabilities of the final merged model. The model was developed through a sequential fine-tuning process: <ol> <li>First, the Gemma3n-e2b-it model was fine-tuned on the comprehensive <b>CDDM-bench dataset</b>.</li> <li>Then, the resulting adapter was further fine-tuned on the conversational <b>6k Agri-LLaVA instruction dataset</b> to enhance its interactive abilities.</li> </ol> </div> <div class=\"kpi tiles\"> <div> <h3>🧠 Base</h3> <p>unsloth/gemma-3n-e2b-it-unsloth-bnb-4bit</p> </div> <div> <h3>📚 Data</h3> <p>CDDM-bench → Agri-LLaVA 6k Chat</p> </div> <div> <h3>🚀 Output</h3> <p>AgriVision-gemma3n (Merged Model)</p> </div> <div> <h3>🎯 Goal</h3> <p>Offline Farmer Assistant App</p> </div> </div> </div>","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-08-06T15:18:55.701990Z","iopub.execute_input":"2025-08-06T15:18:55.702329Z","iopub.status.idle":"2025-08-06T15:18:55.711409Z","shell.execute_reply.started":"2025-08-06T15:18:55.702278Z","shell.execute_reply":"2025-08-06T15:18:55.710352Z"},"_kg_hide-input":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":"<style> .section-hero { position: relative; padding: 20px 22px; border-radius: 18px; background: linear-gradient(135deg, rgba(30,30,40,0.9), rgba(40,30,50,0.9)); border: 1px solid rgba(102,126,234,0.4); box-shadow: 0 10px 28px rgba(0,0,0,0.3); overflow: hidden; color: #e0e0e0; } .section-hero::before, .section-hero::after { content: \"\"; position: absolute; width: 220px; height: 220px; border-radius: 50%; filter: blur(60px); opacity: 0.3; pointer-events: none; } .section-hero::before { top: -80px; left: -60px; background: radial-gradient(closest-side, rgba(102